TMDB_API_KEY=your_tmdb_api_key_here
SERPAPI_API_KEY=your_serpapi_key_here
OMDB_API_KEY=your_omdb_api_key_here
PORT=3001
APP_PASSWORD=change_this_password
ADMIN_EMAIL=admin@kurum.gov.tr

# Aylık SerpAPI çağrı bütçesi (server/services/serpApiCache.js atomik sayacı).
# Tanımsızsa 5000 varsayılır — Developer planının aylık hakkı.
SERPAPI_MONTHLY_BUDGET=5000

# Denetim G-01: kullanici basina GUNLUK canli dis cagri siniri. Onbellekten gelen istekler
# sayilmaz; yalnizca gercekten disariya cikan cagrilar. Bos birakilirsa/0 verilirse 150 kullanilir.
# Sinira ulasan kullanici artik jenerik bir hata degil, 429 ile gercek kota mesajini gorur.
SERPAPI_USER_DAILY_LIMIT=150

# Üretimde tarayıcıdan izin verilen tek origin (CORS allowlist, server/index.js).
# Boş bırakılırsa üretimde hiçbir çapraz-origin isteğe izin verilmez; geliştirmede
# localhost:5173 zaten otomatik eklenir.
APP_ORIGIN=https://gorunurluk.iletisim.gov.tr

# Üretimde 'production' olmalı — Secure çerez bayrağı ve Express'in üretim modu buna bağlı.
NODE_ENV=production

# Dahili LLM sunucusu (OpenAI API uyumlu) — tema sınıflandırma için gerekli
LLM_BASE_URL=your_llm_base_url_here
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_llm_model_here
# LLM sunucusu özel/kurumsal bir CA ile imzalıysa PEM zincirinin yolu (proje köküne göre ya da
# mutlak). Dosyayı depoya eklemeyin; boş bırakılırsa sistem kök sertifikaları kullanılır.
# LLM_CA_PATH=server/certs/internal-ca-chain.pem

# Denetim raporu C.3 — "yetim sinyaller". Bu iki HAFTALIK toplu tarama her hafta ücretli SerpAPI
# cagrisi yapiyor ama sonucu arayuzde hicbir yerde gosterilmiyor; bu yuzden varsayilan olarak
# KAPALI. Ilgili veriyi arayuze baglamaya karar verilirse 'true' yapin.
# NOT: sosyal zenginlestirmenin ANLIK tetikleyicisi (TrendsExplorer'daki tarama butonu) bu
# bayraktan bagimsizdir ve her zaman calisir.
ENABLE_SOCIAL_ENRICHMENT=false
ENABLE_ACTOR_TRENDS=false

# Denetim O-2: ters proxy (nginx/IIS/Traefik) ARKASINDA calisiyorsa 'true' yapin (ya da hop
# sayisini verin, or. 2). Varsayilan KAPALI: proxy yokken acik olursa istemci sahte
# X-Forwarded-For gondererek hiz sinirlarini delebilir. Ayrica bu ayar acikken cerezin Secure
# bayragi X-Forwarded-Proto'dan da turetilir (bkz. server/auth.js isSecureRequest).
TRUST_PROXY=false
